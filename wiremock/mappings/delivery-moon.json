{
  "request": {
    "method": "GET",
    "urlPath": "/delivery/estimate",
    "queryParameters": { "destination": { "equalTo": "Moon", "caseInsensitive": true } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "destination": "Moon", "etaDays": 2, "cost": 9.99, "currency": "GCR" }
  }
}
