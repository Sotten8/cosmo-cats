{
  "request": {
    "method": "GET",
    "urlPath": "/delivery/estimate",
    "queryParameters": { "destination": { "equalTo": "Jupiter", "caseInsensitive": true } }
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 6000,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "destination": "Jupiter", "etaDays": 400, "cost": 999.00, "currency": "GCR" }
  }
}
